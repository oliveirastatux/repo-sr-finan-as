# Porta HTTP
PORT=3000
# Caminho do banco SQLite
DB_PATH=./data/plantao.db

# Demonstração: check-in sempre aberto, nada vai ao RD, botões de dados de exemplo
DEMO_MODE=false

# Senha do painel do gestor
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar sessões (gere com: openssl rand -hex 32)
SESSION_SECRET=
# Token que o tablet usa para se autenticar (gere com: openssl rand -hex 16)
KIOSK_TOKEN=

# Reconhecimento facial: distância máxima aceita (menor = mais rígido)
FACE_MATCH_THRESHOLD=0.5
FACE_MATCH_MARGIN=0.05

# ---- RD Station CRM ----
# Segredo que vai na URL do webhook: /api/webhooks/rd/<RD_WEBHOOK_SECRET>
RD_WEBHOOK_SECRET=
# true = só simula (não altera nada no RD). Deixe true até validar.
RD_DRY_RUN=true
RD_API_BASE=https://api.rd.services/crm/v2
RD_ACCESS_TOKEN=
# ID do usuário do RD que recebe o lead quando ninguém está apto (ex.: gerente)
RD_FALLBACK_OWNER_ID=
